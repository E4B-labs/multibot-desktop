# multibot: one container, one public port — the harness.
#
# Bez przeglądarki celowo: komputer bota to osobny obraz (Dockerfile.computer,
# własny Chrome) albo backend `native` na hoście. Nic w TYM obrazie nie
# uruchamia przeglądarki.
FROM node:24-bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    git xvfb curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile
COPY . .
RUN pnpm build \
 && pnpm build:server
ENV HOME=/data MULTIBOT_HOST=0.0.0.0 MULTIBOT_PORT=8799
VOLUME ["/data"]
EXPOSE 8799
ENTRYPOINT ["bash", "/app/scripts/docker-entrypoint.sh"]
